# ==========================================
# RenoPay Fullstack Environment Variables
# ==========================================

# --- App Settings ---
APP_NAME=RenoPay
ENV=development
DEBUG=true

# --- Database (PostgreSQL / Neon) ---
POSTGRES_USER=renopay
POSTGRES_PASSWORD=renopay
POSTGRES_DB=renopay
# For local Docker: postgresql://renopay:renopay@localhost:5432/renopay
# For Neon Tech cloud: postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://renopay:renopay@localhost:5432/renopay

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Security & Keys ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-64-character-jwt-secret-key-here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-32-byte-base64-fernet-key-here==

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI Assistant (Saathi / Groq) ---
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=

# --- SMS / OTP Configuration ---
# "console" (default for dev), "email" (SMTP OTP), "twilio" (SMS)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- SMTP / Email OTP Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RenoPay
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_SENDS_PER_HOUR=3

# --- CORS Allowed Origins ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://10.0.2.2:8000","http://10.0.2.2:5173","https://renopay-original.vercel.app"]

# --- Frontend Environment Variables (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws
