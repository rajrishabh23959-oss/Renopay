# RenoPay Environment Variables
# Copy this file to .env and fill in real values. Never commit .env itself to Git.

# --- App Settings ---
APP_NAME=RenoPay
ENV=development # development | staging | production
DEBUG=true      # Set to false in production

# --- AI Assistant (Groq Llama 3.3) ---
# Get free API key from https://console.groq.com/keys
GROQ_API_KEY=

# --- Database (Neon PostgreSQL) ---
# Get your connection string from https://console.neon.tech
# Neon connection string format:
# postgresql://neondb_owner:<password>@<endpoint-id>.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample.region.aws.neon.tech/neondb?sslmode=require

# --- Redis (OTP cache, rate limiting, token tracking) ---
REDIS_URL=redis://localhost:6379/0

# --- Security & Cryptography ---
# Required for non-development environments!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Token lifespans
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMS / OTP Provider ---
# "console" logs OTP to backend logs (development only)
# "email" sends real OTP email via SMTP (Gmail, SendGrid, Amazon SES)
# "twilio" sends real SMS via Twilio (requires: pip install twilio)
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- SMTP / Email OTP Configuration ---
# To use Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=RenoPay
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_SENDS_PER_HOUR=3

# --- CORS Allowed Origins ---
# Accepts JSON array or comma-separated list of origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://10.0.2.2:8000","http://10.0.2.2:5173"]
